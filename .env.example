DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/savelanded
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Optional AI provider; without this the assistant uses the approved FAQ fallback.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional transactional email. Enquiries persist and emails queue when unset.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
MAIL_JOB_SECRET=
# Verified public business contacts; omit until confirmed.
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# Optional public database CA certificate (PEM). Verification stays enabled.
DATABASE_SSL_CA=
